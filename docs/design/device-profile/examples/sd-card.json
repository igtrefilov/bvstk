{
  "schema_version": 2,
  "id": "sd_card",
  "device": {
    "model": "SD card",
    "class": "storage"
  },
  "transport": {
    "bus": "spi",
    "controller": "pl_spi_0",
    "chip_select": 0,
    "mode": 0,
    "max_hz": 400000,
    "bits_per_word": 8,
    "bit_order": "msb_first"
  },
  "protocol": {"driver": "sd_spi", "timeout_ms": 1000},
  "resources": [
    {
      "id": "card",
      "kind": "block",
      "access": "ro",
      "first_block": "0x00",
      "block_size_bytes": 512,
      "block_count": "discover",
      "erase_blocks": 0
    }
  ],
  "policy": {
    "read": {"mode": "whitelist", "rules": [{"resource": "card"}]},
    "write": {"mode": "whitelist", "rules": []},
    "erase": {"mode": "whitelist", "rules": []}
  },
  "observability": {"telemetry": true, "events": true}
}
