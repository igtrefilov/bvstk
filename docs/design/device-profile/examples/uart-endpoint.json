{
  "schema_version": 2,
  "id": "uart_endpoint",
  "device": {
    "model": "UART endpoint",
    "class": "serial"
  },
  "transport": {
    "bus": "uart",
    "controller": "uart_1",
    "baud_rate": 115200,
    "data_bits": 8,
    "parity": "none",
    "stop_bits": 1,
    "flow_control": "none"
  },
  "protocol": {"driver": "uart_raw"},
  "resources": [
    {
      "id": "data",
      "kind": "stream",
      "access": "ro",
      "encoding": "bytes",
      "buffer_bytes": 1024,
      "max_chunk_bytes": 256,
      "overflow": "drop_newest"
    }
  ],
  "policy": {
    "read": {"mode": "whitelist", "rules": [{"resource": "data"}]},
    "transmit": {"mode": "whitelist", "rules": []}
  },
  "observability": {"telemetry": true, "events": true}
}
