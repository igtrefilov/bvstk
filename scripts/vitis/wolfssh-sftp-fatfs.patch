@@ -1940,0 +1941,74 @@ int wolfSSH_SFTP_CreateStatus(WOLFSSH* ssh, word32 status, word32 reqId,
+#ifdef WOLFSSH_BVSTK_FATFS
+/* Translate the Linux-like paths exposed by the BVSTK SFTP service to the
+ * numeric FatFs volumes used by the firmware. The virtual root and ordinary
+ * absolute paths default to the PS SD card; /sd-pl and /sd-pl: select the
+ * PL-backed SD volume, while /flash and /flash: select QSPI. */
+static int BvstkFatFsPath(char* path, word32 pathSz)
+{
+    const char* relative = NULL;
+    char drive = '0';
+    char mapped[WOLFSSH_MAX_FILENAME];
+    int mappedSz;
+
+    if (path == NULL || pathSz == 0) {
+        return WS_BAD_ARGUMENT;
+    }
+
+    if (WSTRNCMP(path, "/sd-pl:", 7) == 0 &&
+            (path[7] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[7]))) {
+        drive = '2';
+        relative = path + 7;
+    }
+    else if (WSTRNCMP(path, "/sd-pl", 6) == 0 &&
+            (path[6] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[6]))) {
+        drive = '2';
+        relative = path + 6;
+    }
+    else if (WSTRNCMP(path, "/sd:", 4) == 0 &&
+            (path[4] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[4]))) {
+        relative = path + 4;
+    }
+    else if (WSTRNCMP(path, "/sd", 3) == 0 &&
+            (path[3] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[3]))) {
+        relative = path + 3;
+    }
+    else if (WSTRNCMP(path, "/flash:", 7) == 0 &&
+            (path[7] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[7]))) {
+        drive = '1';
+        relative = path + 7;
+    }
+    else if (WSTRNCMP(path, "/flash", 6) == 0 &&
+            (path[6] == '\0' || WOLFSSH_SFTP_IS_DELIM(path[6]))) {
+        drive = '1';
+        relative = path + 6;
+    }
+    else if ((path[0] == '/') &&
+            (path[1] == '0' || path[1] == '1' || path[1] == '2') &&
+            path[2] == ':') {
+        drive = path[1];
+        relative = path + 3;
+    }
+    else if (path[0] == '/') {
+        relative = path;
+    }
+    else if ((path[0] == '0' || path[0] == '1' || path[0] == '2') &&
+            path[1] == ':') {
+        return WS_SUCCESS;
+    }
+    else {
+        return WS_INVALID_PATH_E;
+    }
+
+    if (relative[0] == '\0') {
+        relative = "/";
+    }
+    mappedSz = WSNPRINTF(mapped, sizeof(mapped), "%c:%s", drive, relative);
+    if (mappedSz < 0 || (word32)mappedSz >= sizeof(mapped) ||
+            (word32)mappedSz >= pathSz) {
+        return WS_INVALID_PATH_E;
+    }
+    WMEMCPY(path, mapped, (word32)mappedSz + 1);
+    return WS_SUCCESS;
+}
+#endif /* WOLFSSH_BVSTK_FATFS */
+
