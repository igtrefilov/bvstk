+/* A caller releases FIL/DIR storage after close, including on failed writes.
+ * Drop the in-memory entry even when a failed sync or an offline medium makes
+ * validate() fail. A remount already discarded the previous generation. */
+static FRESULT close_object_lock (FFOBJID* obj)
+{
+	FATFS* fs = obj ? obj->fs : 0;
+	FRESULT res = FR_INVALID_OBJECT;
+
+	if (!fs) return res;
+#if FF_FS_REENTRANT
+	/* Only disposal must wait for ownership; ordinary I/O keeps its timeout. */
+	while (!lock_fs(fs)) {}
+#endif
+	if (fs->fs_type && fs->id == obj->id) {
+		res = obj->lockid ? dec_lock(obj->lockid) : FR_OK;
+	}
+	obj->fs = 0;
+#if FF_FS_REENTRANT
+	unlock_fs(fs, FR_OK);
+#endif
+	return res;
+}
+
+
 static void clear_lock (	/* Clear lock entries of the volume */
 	FATFS *fs
 )
