+	if (!fp) return FR_INVALID_OBJECT;
+	sync_result = f_sync(fp);
+	close_result = close_object_lock(&fp->obj);
+	return sync_result != FR_OK ? sync_result : close_result;
+#else
 	FRESULT res = FR_DISK_ERR;
